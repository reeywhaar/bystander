# Plans, scratch scripts, deploy keys — mine, not the repository's.
private

# The built frontend, except the one file that must be tracked. It keeps web/dist in
# existence in a fresh clone, so BYSTANDER_WEB_DIR=web/dist serves the placeholder page rather
# than failing to start: an empty bundle directory is a page saying nothing was built, and a
# missing one is refused as a mistyped path. See internal/cli/serve.go.
web/dist/*
!web/dist/.gitkeep

node_modules

# A local instance's databases, and the WAL sidecars beside them.
data/
*.db
*.db-wal
*.db-shm

# Local binaries, from `go build` without -o.
/bystander

.DS_Store
